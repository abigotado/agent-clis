#!/usr/bin/env bash
# agent-clis pre-push quality gate.
#
# Install with `.githooks/install`, remove with `.githooks/uninstall`.
# Do not bypass with `git push --no-verify` — if the gate is wrong, fix the gate.
#
# The gate validates the commits being pushed, not the working tree: each pushed
# tip is checked out into a temporary worktree and gated there. Anything the
# hook cannot resolve fails closed.
set -euo pipefail

fail() {
  echo "pre-push: $1" >&2
  exit 1
}

# Git hands a hook its own repository through the environment; the temporary
# worktrees must resolve their own.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX

repo_root=$(git rev-parse --show-toplevel) || fail "not inside a git checkout"
cd "$repo_root"

# Gate one checked-out tree. The caller runs it in a subshell with its working
# directory at that tree's root and stdin closed.
gate_tree() {
  local label=$1 modules module dir unformatted

  # Every tracked Go module is gated. No tracked module at all means the
  # checkout is wrong, so it fails instead of skipping the Go gate.
  modules=$(git -c core.quotePath=false ls-files -- go.mod '*/go.mod')
  [ -n "$modules" ] || fail "$label: no tracked Go module"

  # Modules are read on fd 3 so a command in the body that reads stdin cannot
  # swallow the modules that follow.
  while IFS= read -r -u 3 module; do
    dir=$(dirname "$module")
    echo "pre-push: $label: $dir: gofmt"
    # Tracked files only: a filesystem walk would descend into nested worktrees.
    unformatted=$(git ls-files -z -- "$dir/*.go" | xargs -0 gofmt -l) \
      || fail "$dir: gofmt failed"
    if [ -n "$unformatted" ]; then
      echo "$unformatted" >&2
      fail "$dir: the files above are not gofmt-clean"
    fi

    echo "pre-push: $label: $dir: go vet"
    GOWORK=off go -C "$dir" vet ./... || fail "$dir: go vet failed"

    echo "pre-push: $label: $dir: go build"
    GOWORK=off go -C "$dir" build ./... || fail "$dir: go build failed"

    echo "pre-push: $label: $dir: go test"
    GOWORK=off go -C "$dir" test -race ./... || fail "$dir: go test failed"
  done 3<<<"$modules"

  # The agent harness is compiled, not hand-written. A drifted mirror means the
  # canonical .agents/ inputs changed without recompiling.
  local python_bin="${AGENT_HARNESS_PYTHON:-python3}"
  if [ -d .agents ] && "$python_bin" -c 'pass' >/dev/null 2>&1; then
    echo "pre-push: $label: agent harness"
    "$python_bin" .agents/scripts/sync-rules.py --check || fail "Cursor rule mirrors are out of sync"
    "$python_bin" -m unittest discover -s .agents/tests -p 'test_*.py' -q \
      || fail "harness unit tests failed"

    local tracked
    tracked=$(git ls-files .claude .codex)
    if [ -n "$tracked" ]; then
      echo "$tracked" >&2
      fail "generated provider mirrors are committed; remove them"
    fi
  fi
}

# The provider compiler is the machine-local global harness, so CI cannot run
# it. Its mirrors are git-ignored, so they exist only in the real checkout and
# describe only the .agents tree checked out there: a pushed tip whose .agents
# tree differs cannot be verified against them, so it fails closed.
check_provider_mirrors() {
  local commit=$1 python_bin="${AGENT_HARNESS_PYTHON:-python3}" tip_agents head_agents
  tip_agents=$(git rev-parse --verify "${commit}:.agents" 2>/dev/null || true)
  [ -n "$tip_agents" ] || return 0
  head_agents=$(git rev-parse --verify 'HEAD:.agents' 2>/dev/null || true)
  [ "$tip_agents" = "$head_agents" ] \
    || fail "${commit:0:12}: .agents differs from the checked-out HEAD, so the provider mirrors cannot be verified; check this branch out and push it"
  # The compiler reads the working tree, so it must equal HEAD's .agents.
  git diff --quiet HEAD -- .agents && [ -z "$(git ls-files --others --exclude-standard -- .agents)" ] \
    || fail ".agents has uncommitted changes; commit or discard them before pushing"
  [ -d .agents ] && "$python_bin" -c 'pass' >/dev/null 2>&1 || return 0
  local global_compiler="${HOME}/.agents/compiler.py"
  if [ -f "$global_compiler" ]; then
    "$python_bin" "$global_compiler" --source .agents --root . --scope project --check \
      || fail "provider mirrors are out of date; recompile before pushing"
  else
    echo "pre-push: WARN: $global_compiler not found; skipped provider mirror check" >&2
  fi
}

# Read every pushed ref before running anything that could consume stdin.
refs=$(cat)

tmp=""
cleanup() {
  local worktree
  [ -n "$tmp" ] || return 0
  for worktree in "$tmp"/wt-*; do
    if [ -e "$worktree" ] && ! git worktree remove --force "$worktree" >/dev/null 2>&1; then
      echo "pre-push: WARN: could not remove temporary worktree $worktree" >&2
    fi
  done
  rm -rf "$tmp"
  return 0
}
trap cleanup EXIT

seen=" "
gated=0
while IFS=' ' read -r -u 3 local_ref local_sha remote_ref remote_sha _extra; do
  [ -n "${local_ref}${local_sha}" ] || continue
  [ -n "$local_ref" ] && [ -n "$local_sha" ] && [ -n "$remote_ref" ] && [ -n "$remote_sha" ] \
    || fail "cannot parse the pushed ref line: ${local_ref} ${local_sha} ${remote_ref}"
  # Deleting a ref pushes nothing to validate.
  if [[ "$local_sha" =~ ^0+$ ]]; then
    echo "pre-push: $remote_ref: delete, nothing to validate"
    continue
  fi
  commit=$(git rev-parse --verify "${local_sha}^{commit}" 2>/dev/null) \
    || fail "$local_ref: $local_sha does not resolve to a commit"
  case "$seen" in *" $commit "*) continue ;; esac
  seen="$seen$commit "

  # Only a push that adds or updates a ref needs Go and scratch space.
  command -v go >/dev/null 2>&1 || fail "go is not on PATH"
  if [ -z "$tmp" ]; then
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/pre-push.XXXXXX") || fail "cannot create a temporary directory"
  fi
  worktree="$tmp/wt-$gated"
  # The pushed commit may carry its own hooks; the checkout must not run them.
  git -c core.hooksPath=/dev/null worktree add --quiet --detach "$worktree" "$commit" >/dev/null \
    || fail "$local_ref: cannot check out $commit"
  dirty=$(git -C "$worktree" status --porcelain --untracked-files=all) \
    || fail "$local_ref: cannot inspect the checkout of $commit"
  [ -z "$dirty" ] || fail "$local_ref: the checkout of $commit is not clean"
  (cd "$worktree" && gate_tree "${commit:0:12}" </dev/null) || exit 1
  gated=$((gated + 1))
  check_provider_mirrors "$commit"
done 3<<<"$refs"

[ "$gated" -gt 0 ] && echo "pre-push: ok" || echo "pre-push: nothing to validate"
