#!/usr/bin/env bash
# Point this clone's Git hooks at .githooks/.
#
# It sets the local core.hooksPath, replacing any hooks directory set there. An
# agent may run it where no hooks path is set; a custom hooks directory is the
# developer's to chain, and `uninstall` stays the developer's call. See
# .agents/rules/quality-gates.md.
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

chmod +x .githooks/pre-push
git config --local core.hooksPath .githooks

echo "Installed: core.hooksPath = $(git config --local --get core.hooksPath)"
