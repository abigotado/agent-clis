# Generated agent-harness mirrors. The canonical inputs live in .agents/.
# These must never be committed: hook commands render with an absolute {root}
# path, so committing them bakes one machine's checkout path into the repo.
# CI enforces this in .github/workflows/ci.yaml.
.claude/
.codex/

# Go build output
/youtrack-agent-cli/youtrack-agent-cli
/youtrack-agent-cli/dist/
/bin/
/dist/
*.test
*.exe
*.prof
coverage.out

# Generated security-audit evidence. Keep the reviewed Markdown summary only.
/reports/.artifacts/
/reports/.history/
/reports/security_audit.json

# A workspace is local: every module builds with GOWORK=off.
/go.work
/go.work.sum

# Harness script bytecode
__pycache__/
*.py[cod]

# Local environment
.env
.env.*
.DS_Store
